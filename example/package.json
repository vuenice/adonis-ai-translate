{
  "name": "adonis-ai-translate-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Sample Adonis 7 app that installs adonis-ai-translate via file:..",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace.js build",
    "dev": "node ace.js serve --watch",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#exceptions/*": "./app/exceptions/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "^7.3.1",
    "adonis-ai-translate": "file:..",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "~22.13.14",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~5.8.3",
    "vite": "^6.1.1",
    "youch": "^4.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/middleware/*.ts"
    ]
  }
}
